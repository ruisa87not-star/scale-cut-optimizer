{
  "name": "cutting-stock-desktop",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "description": "React desktop UI with a native C++ cutting-stock optimiser.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "native:build": "native\\build-native.cmd",
    "package": "native\\build-native.cmd && vite build && electron-builder --win portable"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "vite": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.scale.cuttingoptimizer",
    "productName": "Cutting Stock Optimizer",
    "directories": {
      "output": "release"
    },
    "electronVersion": "40.6.0",
    "compression": "normal",
    "electronLanguages": [
      "zh-TW",
      "en-US"
    ],
    "win": {
      "signAndEditExecutable": false
    },
    "files": [
      "frontend-dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/build/Release/cutting_optimizer.exe",
        "to": "native/cutting_optimizer.exe"
      }
    ]
  }
}
